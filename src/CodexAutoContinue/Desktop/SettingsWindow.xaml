<Window x:Class="CodexAutoContinue.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Codex 续航 · 设置" Width="820" Height="790" MinWidth="700" MinHeight="600" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
  <Grid Margin="30,24,30,23"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,22"><TextBlock Text="MAKE CONTINUITY YOURS" Style="{StaticResource Eyebrow}"/><TextBlock Text="设置" FontSize="26" Margin="0,7,0,0"/><TextBlock Text="保存后生效。Webhook 地址与签名密钥通过 Windows 当前用户加密保存。" Style="{StaticResource MutedText}" Margin="0,9,0,0"/></StackPanel>
    <TabControl x:Name="SettingsTabs" Grid.Row="1">
      <TabItem Header="重试与消息"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="3,0,13,15">
        <TextBlock Text="续接消息" FontSize="17" Margin="0,0,0,8"/><TextBlock Text="手动与自动续接共用此消息，界面语言保持中文。" Style="{StaticResource MutedText}" Margin="0,0,0,17"/>
        <UniformGrid Columns="3" Margin="0,0,0,18"><Border CornerRadius="8" BorderBrush="#52684F" BorderThickness="1" Background="#24352B" Padding="13,17" Margin="0,0,9,0"><StackPanel><RadioButton x:Name="ChineseReply" GroupName="reply" Content="中文" Checked="ReplyChanged"/><TextBlock Text="继续" Foreground="#A8C2A6" Margin="25,8,0,0" FontSize="11"/></StackPanel></Border><Border CornerRadius="8" BorderBrush="#52684F" BorderThickness="1" Background="#24352B" Padding="13,17" Margin="0,0,9,0"><StackPanel><RadioButton x:Name="EnglishReply" GroupName="reply" Content="英文" Checked="ReplyChanged"/><TextBlock Text="continue" Foreground="#A8C2A6" Margin="25,8,0,0" FontSize="11"/></StackPanel></Border><Border CornerRadius="8" BorderBrush="#52684F" BorderThickness="1" Background="#24352B" Padding="13,17"><StackPanel><RadioButton x:Name="CustomReply" GroupName="reply" Content="自定义" Checked="ReplyChanged"/><TextBlock Text="使用输入内容" Foreground="#A8C2A6" Margin="25,8,0,0" FontSize="11"/></StackPanel></Border></UniformGrid>
        <StackPanel x:Name="CustomGroup"><TextBlock Text="自定义续接消息" FontSize="12" Margin="0,0,0,8"/><TextBox x:Name="CustomText" MaxLength="1000" AutomationProperties.Name="自定义续接消息" TextChanged="CustomChanged"/><TextBlock Text="最多 1000 个字符；保存时移除首尾空白，内容不能为空。" Style="{StaticResource MutedText}" FontSize="10" Margin="0,7,0,16"/></StackPanel>
        <Border CornerRadius="8" Background="#26392D" BorderBrush="#4A6248" BorderThickness="1" Padding="15" Margin="0,0,0,24"><StackPanel><TextBlock Text="待保存的最终消息" Foreground="#A7C49B" FontSize="11"/><TextBlock x:Name="MessagePreview" Text="继续" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
        <TextBlock Text="重试策略" FontSize="17" Margin="0,0,0,10"/><TextBlock Text="仅对新确认的终止失败重试。Codex 内部重试、等待审批、主动停止与正常完成均不自动续接。" Style="{StaticResource MutedText}" LineHeight="19" Margin="0,0,0,17"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="首次网络重试等待（秒）" FontSize="12" Margin="0,0,0,8"/><TextBox x:Name="NetworkDelay" AutomationProperties.Name="首次网络重试等待秒数"/><TextBlock Text="后续等待指数增加，最长 300 秒。" Style="{StaticResource MutedText}" FontSize="10" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="每次异常最多续接次数" FontSize="12" Margin="0,0,0,8"/><TextBox x:Name="MaxAttempts" AutomationProperties.Name="每次异常最多续接次数"/><TextBlock Text="自动续接再失败时沿用同一次数预算。" Style="{StaticResource MutedText}" FontSize="10" Margin="0,7,0,0"/></StackPanel></Grid>
        <Border Background="#26332D" CornerRadius="7" Padding="13" Margin="0,21,0,0"><TextBlock Text="额度限制需要可靠的恢复时间；无法确认恢复时间的限制会显示为需要处理。发送成功不等于任务恢复，必须观察后续实际执行。" Style="{StaticResource MutedText}" LineHeight="19"/></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="通知设置"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="3,0,13,15">
        <TextBlock Text="将重要状态送达" FontSize="17" Margin="0,0,0,8"/><TextBlock Text="通知包含会话名称、状态与重试计划，不包含完整会话、命令输出或凭据。" Style="{StaticResource MutedText}" LineHeight="19" Margin="0,0,0,18"/>
        <UniformGrid Columns="4" Margin="0,0,0,21"><RadioButton x:Name="DingTalkProvider" GroupName="provider" Content="钉钉" Checked="ProviderChanged"/><RadioButton x:Name="FeishuProvider" GroupName="provider" Content="飞书" Checked="ProviderChanged"/><RadioButton x:Name="WeComProvider" GroupName="provider" Content="企业微信" Checked="ProviderChanged"/><RadioButton x:Name="GenericProvider" GroupName="provider" Content="通用 JSON" Checked="ProviderChanged"/></UniformGrid>
        <TextBlock Text="渠道名称" FontSize="12" Margin="0,0,0,8"/><TextBox x:Name="ChannelName" MaxLength="48" AutomationProperties.Name="通知渠道名称" Margin="0,0,0,18"/>
        <TextBlock Text="Webhook 接收地址" FontSize="12" Margin="0,0,0,8"/><PasswordBox x:Name="WebhookUrl" AutomationProperties.Name="Webhook 接收地址"/><TextBlock Text="请输入 HTTPS 地址；地址中的 token 一并加密，摘要不会显示完整地址。" Style="{StaticResource MutedText}" FontSize="10" Margin="0,7,0,17"/>
        <StackPanel x:Name="SecretGroup"><TextBlock Text="签名密钥（可选）" FontSize="12" Margin="0,0,0,8"/><PasswordBox x:Name="SigningSecret" AutomationProperties.Name="Webhook 签名密钥"/><TextBlock Text="机器人启用加签时填写。平台未启用加签时留空。" Style="{StaticResource MutedText}" FontSize="10" Margin="0,7,0,18"/></StackPanel>
        <CheckBox x:Name="EnableNotifications" Content="启用通知" Margin="0,0,0,18"/><TextBlock Text="通知事件" FontSize="12" Margin="0,0,0,11"/><WrapPanel Margin="0,0,0,21"><CheckBox x:Name="FailureEvent" Content="确认异常" Margin="0,0,26,0"/><CheckBox x:Name="RecoveryEvent" Content="确认恢复" Margin="0,0,26,0"/><CheckBox x:Name="ExhaustedEvent" Content="重试耗尽"/></WrapPanel>
        <Border Background="#29372C" BorderBrush="#52684A" BorderThickness="1" CornerRadius="7" Padding="13" Margin="0,0,0,15"><TextBlock Text="“发送测试通知”将真实调用当前输入的 Webhook。测试不保存设置。平台失败结果会显示在此处。" Style="{StaticResource MutedText}" LineHeight="19"/></Border>
        <Button x:Name="TestButton" Content="发送测试通知" HorizontalAlignment="Left" Click="TestClick"/><TextBlock x:Name="TestResult" TextWrapping="Wrap" Foreground="#B5D0B3" Margin="0,12,0,0" LineHeight="20"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="连接与应用"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="3,0,13,15">
        <TextBlock Text="Codex 本地连接" FontSize="17" Margin="0,0,0,10"/><TextBlock Text="从当前 Windows 用户的 Codex 数据目录只读观察桌面会话，使用现有 CLI 与认证发送消息。不会复制账号凭据。" Style="{StaticResource MutedText}" LineHeight="19" Margin="0,0,0,18"/>
        <TextBlock Text="Codex 数据目录" FontSize="12" Margin="0,0,0,8"/><TextBox x:Name="CodexHome" AutomationProperties.Name="Codex 数据目录"/><TextBlock Text="通常为当前用户目录下的 .codex。程序不会修改 Codex 数据库。" Style="{StaticResource MutedText}" FontSize="10" Margin="0,7,0,17"/>
        <TextBlock Text="Codex CLI 路径" FontSize="12" Margin="0,0,0,8"/><TextBox x:Name="CliPath" AutomationProperties.Name="Codex CLI 路径"/><TextBlock Text="留空时自动寻找桌面端自带的 codex.exe，也可填写完整路径。" Style="{StaticResource MutedText}" FontSize="10" Margin="0,7,0,17"/>
        <TextBlock Text="刷新间隔（秒）" FontSize="12" Margin="0,0,0,8"/><TextBox x:Name="PollSeconds" Width="150" HorizontalAlignment="Left" AutomationProperties.Name="刷新间隔秒数" Margin="0,0,0,22"/>
        <Border Background="#26362F" BorderBrush="#48604D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,24"><StackPanel><TextBlock Text="当前连接状态" FontSize="12" Margin="0,0,0,8"/><TextBlock x:Name="ConnectionDetails" Style="{StaticResource MutedText}" LineHeight="19"/><TextBlock Text="历史中的“执行中”不代表当前仍在执行。首次读取的历史记录不会用于自动续接；未确认送达时保持等待，避免重复发送。" Style="{StaticResource MutedText}" FontSize="10" LineHeight="18" Margin="0,10,0,0"/></StackPanel></Border>
        <TextBlock Text="应用行为" FontSize="17" Margin="0,0,0,17"/><CheckBox x:Name="CloseToTray" Content="关闭窗口时最小化到系统托盘" Margin="0,0,0,17"/><CheckBox x:Name="StartWithWindows" Content="登录 Windows 后自动启动" Margin="0,0,0,17"/><TextBlock x:Name="DataPath" Style="{StaticResource MutedText}" LineHeight="20" TextWrapping="Wrap"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="应用升级"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="3,0,13,15">
        <TextBlock Text="保持最新，继续推进" FontSize="18" Margin="0,0,0,9"/>
        <TextBlock Text="自动下载新版本，在程序空闲时重启安装。设置与监控记录会保留；安装失败时自动回退。" Style="{StaticResource MutedText}" LineHeight="20" Margin="0,0,0,20"/>
        <Border CornerRadius="9" Background="#26392D" BorderBrush="#4A6248" BorderThickness="1" Padding="17" Margin="0,0,0,20">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,18,0"><TextBlock Text="当前版本" FontSize="11" Foreground="#A7C49B"/><TextBlock x:Name="CurrentVersion" Text="—" FontSize="20" FontFamily="Bahnschrift" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="可用版本" FontSize="11" Foreground="#A7C49B"/><TextBlock x:Name="AvailableVersion" Text="尚未发现新版本" FontSize="16" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
          </Grid>
        </Border>
        <TextBlock x:Name="UpdateStatus" Text="等待检查更新" TextWrapping="Wrap" LineHeight="21" Foreground="#BDCFB7" Margin="0,0,0,12"/>
        <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="6" Background="#23362D" Foreground="#A5C49B" BorderThickness="0" Visibility="Collapsed" Margin="0,0,0,17"/>
        <WrapPanel Margin="0,0,0,12"><Button x:Name="CheckUpdateButton" Content="立即检查更新" Click="CheckUpdatesClick" Margin="0,0,10,8"/><Button x:Name="InstallUpdateButton" Content="保存设置并重启安装" Style="{StaticResource PrimaryButton}" Click="InstallUpdateClick" IsEnabled="False" Margin="0,0,0,8"/></WrapPanel>
        <TextBlock Text="立即检查使用已保存的更新通道；修改开关后请先保存设置。" Style="{StaticResource MutedText}" FontSize="10" LineHeight="18" Margin="0,0,0,24"/>
        <TextBlock Text="升级方式" FontSize="17" Margin="0,0,0,16"/>
        <CheckBox x:Name="AutoCheckUpdates" Content="启动时自动检查，此后每 6 小时检查一次" Margin="0,0,0,16"/>
        <CheckBox x:Name="AutoInstallUpdates" Content="下载完成后，在程序空闲时自动重启安装" Margin="0,0,0,16"/>
        <CheckBox x:Name="IncludePrereleaseUpdates" Content="接收预览版更新" Margin="0,0,0,20"/>
        <Border Background="#26332D" CornerRadius="8" Padding="14" Margin="0,0,0,21"><StackPanel>
          <TextBlock Text="空闲时才重启" FontSize="12" Margin="0,0,0,8"/>
          <TextBlock Text="正在续接会话、投递通知或编辑设置时会等待。重启前保存监控状态，待确认的消息不会重复发送。网络检查失败不会中断监控。" Style="{StaticResource MutedText}" LineHeight="20"/>
        </StackPanel></Border>
        <TextBlock Text="更新来源" FontSize="12" Margin="0,0,0,8"/>
        <TextBlock Text="GitHub Releases · tvcmall-dev/codex-auto-continue" Foreground="#AAC6A4" FontSize="11" TextWrapping="Wrap"/>
        <TextBlock Text="只下载本项目发布的 Windows EXE，校验通过后安装，不请求管理员权限。预览版仍保留当前 Codex 桌面恢复接口的已知限制。" Style="{StaticResource MutedText}" FontSize="10" LineHeight="18" Margin="0,9,0,0"/>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Feedback" Text="修改尚未保存。" Foreground="#AFC5A9" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/><Button x:Name="CancelButton" Grid.Column="1" Content="取消" Click="CancelClick" Margin="0,0,10,0"/><Button x:Name="SaveButton" Grid.Column="2" Content="保存设置" Style="{StaticResource PrimaryButton}" Click="SaveClick"/></Grid>
  </Grid>
</Window>
